/* ============================================================
   QuickStart - Calm, minimal stylesheet

   Design rules:
   - One neutral base (soft warm grey) + a single restrained accent.
   - Depth comes from hairline borders and whitespace, not from
     saturated fills or heavy shadows.
   - Corner radii stay small and consistent; spacing follows a
     4/8/12/16 rhythm.
   ============================================================ */

/* ---------- Base ---------- */
QWidget {
    font-family: "Segoe UI", "Microsoft YaHei", "PingFang SC", "Noto Sans CJK SC", sans-serif;
    font-size: 13px;
    color: #2f3337;
}

QMainWindow {
    background-color: #f4f5f6;
}

QMainWindow QWidget#centralwidget {
    background: transparent;
}

QDialog {
    background-color: #ffffff;
}

/* ---------- Menu bar ---------- */
QMenuBar {
    background-color: #ffffff;
    color: #3c4043;
    border: none;
    border-bottom: 1px solid #e6e8ea;
    padding: 4px 6px;
    font-size: 13px;
}

QMenuBar::item {
    background: transparent;
    padding: 5px 12px;
    margin: 0px 1px;
    border-radius: 6px;
    color: #3c4043;
}

QMenuBar::item:selected {
    background-color: #eef0f2;
    color: #1a1c1e;
}

QMenuBar::item:pressed {
    background-color: #e3e6e8;
}

/* ---------- Menus ---------- */
QMenu {
    background-color: #ffffff;
    border: 1px solid #e0e3e6;
    border-radius: 8px;
    padding: 5px;
}

QMenu::item {
    padding: 7px 30px 7px 14px;
    border-radius: 5px;
    color: #2f3337;
}

QMenu::item:selected {
    background-color: #eef0f2;
    color: #1a1c1e;
}

QMenu::item:disabled {
    color: #b4b8bc;
}

QMenu::separator {
    height: 1px;
    background-color: #edeff1;
    margin: 4px 10px;
}

QMenu::right-arrow {
    width: 10px;
}

/* ---------- Icon grid ---------- */
QListWidget {
    background-color: transparent;
    border: none;
    outline: none;
    padding: 10px 10px 6px 10px;
}

QListWidget::item {
    border: none;
    background: transparent;
}

/* ---------- Command list (dialogs) ---------- */
QListWidget#cmdListWidget {
    background-color: #fbfbfc;
    border: 1px solid #e0e3e6;
    border-radius: 6px;
    padding: 3px;
    outline: none;
}

QListWidget#cmdListWidget::item {
    padding: 7px 10px;
    border-radius: 5px;
    color: #2f3337;
}

QListWidget#cmdListWidget::item:hover {
    background-color: #f0f2f4;
}

QListWidget#cmdListWidget::item:selected {
    background-color: #e3edfb;
    color: #14538a;
}

/* ---------- Buttons ---------- */
QPushButton {
    background-color: #ffffff;
    color: #2f3337;
    border: 1px solid #d8dcdf;
    border-radius: 6px;
    padding: 7px 18px;
    font-size: 13px;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #f4f6f8;
    border-color: #c3c8cd;
}

QPushButton:pressed {
    background-color: #e9ecef;
}

QPushButton:focus {
    border-color: #8ab4e8;
}

QPushButton:disabled {
    background-color: #f5f6f7;
    color: #b4b8bc;
    border-color: #e6e8ea;
}

/* Primary action: the only filled button in the dialogs */
QPushButton#confirmBtn,
QPushButton#addCmdBtn {
    background-color: #2d6cb5;
    color: #ffffff;
    border: 1px solid #2d6cb5;
}

QPushButton#confirmBtn:hover,
QPushButton#addCmdBtn:hover {
    background-color: #245a99;
    border-color: #245a99;
}

QPushButton#confirmBtn:pressed,
QPushButton#addCmdBtn:pressed {
    background-color: #1d4a7e;
}

QPushButton#cancelBtn {
    background-color: #ffffff;
    color: #5f6368;
    border: 1px solid #d8dcdf;
}

QPushButton#cancelBtn:hover {
    background-color: #f4f6f8;
    border-color: #c3c8cd;
}

QPushButton#selectIconBtn,
QPushButton#selectExeBtn {
    background-color: #ffffff;
    color: #2d6cb5;
    border: 1px solid #d8dcdf;
    padding: 6px 14px;
}

QPushButton#selectIconBtn:hover,
QPushButton#selectExeBtn:hover {
    background-color: #eef4fb;
    border-color: #b9d0ea;
}

QPushButton#delCmdBtn {
    background-color: #ffffff;
    color: #b03a3a;
    border: 1px solid #e3c6c6;
}

QPushButton#delCmdBtn:hover {
    background-color: #fdf2f2;
    border-color: #cf9b9b;
}

/* ---------- Line edit ---------- */
QLineEdit {
    border: 1px solid #d8dcdf;
    border-radius: 6px;
    padding: 7px 10px;
    font-size: 13px;
    background-color: #ffffff;
    color: #2f3337;
    selection-background-color: #cfe0f5;
    selection-color: #14538a;
}

QLineEdit:focus {
    border-color: #8ab4e8;
    background-color: #ffffff;
}

QLineEdit:read-only {
    background-color: #f7f8f9;
    color: #6b7075;
}

/* ---------- Group box ---------- */
QGroupBox {
    font-size: 13px;
    color: #3c4043;
    border: 1px solid #e0e3e6;
    border-radius: 8px;
    margin-top: 12px;
    padding: 16px 12px 12px 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0px 8px;
    background-color: transparent;
    color: #6b7075;
    font-weight: 500;
}

/* ---------- Labels ---------- */
QLabel {
    color: #5f6368;
    font-size: 13px;
}

/* ---------- Scroll bars ---------- */
QScrollBar:vertical {
    width: 10px;
    background: transparent;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #cdd2d7;
    border-radius: 4px;
    min-height: 32px;
}

QScrollBar::handle:vertical:hover {
    background: #b0b6bc;
}

QScrollBar:horizontal {
    height: 10px;
    background: transparent;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: #cdd2d7;
    border-radius: 4px;
    min-width: 32px;
}

QScrollBar::handle:horizontal:hover {
    background: #b0b6bc;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0px;
    height: 0px;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
}

/* ---------- Status bar ---------- */
QStatusBar {
    background-color: #ffffff;
    border-top: 1px solid #e6e8ea;
    color: #6b7075;
    font-size: 12px;
}

QStatusBar::item {
    border: none;
}

/* ---------- Tool tip ---------- */
QToolTip {
    background-color: #2f3337;
    color: #ffffff;
    border: none;
    border-radius: 5px;
    padding: 6px 9px;
    font-size: 12px;
}

/* ---------- Message box ---------- */
QMessageBox {
    background-color: #ffffff;
}

QMessageBox QLabel {
    color: #2f3337;
    font-size: 13px;
    min-width: 220px;
}

QMessageBox QPushButton {
    min-width: 76px;
}

/* ---------- Combo box ---------- */
QComboBox {
    background-color: #ffffff;
    color: #2f3337;
    border: 1px solid #d8dcdf;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 12px;
    min-width: 78px;
}

QComboBox:hover {
    border-color: #c3c8cd;
}

QComboBox:focus {
    border-color: #8ab4e8;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox::down-arrow {
    width: 9px;
    height: 9px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #2f3337;
    border: 1px solid #e0e3e6;
    border-radius: 6px;
    padding: 3px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 5px 10px;
    border-radius: 4px;
    min-height: 22px;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #eef0f2;
    color: #1a1c1e;
}

/* ---------- Spacers ---------- */
QSpacerItem {
    width: 0;
    height: 0;
}
